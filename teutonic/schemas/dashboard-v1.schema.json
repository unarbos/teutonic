{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teutonic.ai/schemas/dashboard-v1.schema.json",
  "title": "Teutonic dashboard payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "publication_id", "generated_at", "updated_at",
    "source_watermark", "chain", "king", "king_payout", "king_chain",
    "stats", "current_eval", "queue", "history", "dataset_versions", "weight_status",
    "service_status", "market"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "publication_id": { "type": "string", "format": "uuid" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "source_watermark": { "type": "integer", "minimum": 0 },
    "chain": { "$ref": "#/$defs/chain" },
    "king": { "oneOf": [{ "$ref": "#/$defs/king" }, { "type": "null" }] },
    "king_payout": { "$ref": "#/$defs/payout" },
    "king_chain": {
      "type": "array",
      "items": { "$ref": "#/$defs/reign" }
    },
    "stats": { "$ref": "#/$defs/stats" },
    "current_eval": {
      "oneOf": [{ "$ref": "#/$defs/current_eval" }, { "type": "null" }]
    },
    "queue": { "type": "array", "items": { "$ref": "#/$defs/queue_entry" } },
    "history": { "type": "array", "items": { "$ref": "#/$defs/history_entry" } },
    "dataset_versions": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataset_version" }
    },
    "weight_status": { "$ref": "#/$defs/weight_status" },
    "service_status": { "$ref": "#/$defs/service_status" },
    "market": { "oneOf": [{ "$ref": "#/$defs/market" }, { "type": "null" }] }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "nullable_timestamp": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "nullable_string": { "type": ["string", "null"] },
    "nullable_number": { "type": ["number", "null"] },
    "nullable_integer": { "type": ["integer", "null"] },
    "dataset_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "proportion", "manifest_url", "manifest_sha256", "source_repo", "tokenizer", "dtype", "tokenization_mode", "sequence_length", "total_tokens", "total_shards", "estimated_sequences"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dataset": { "type": "string", "minLength": 1 },
        "proportion": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "manifest_url": { "type": "string", "pattern": "^https://" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_repo": { "$ref": "#/$defs/nullable_string" },
        "tokenizer": { "$ref": "#/$defs/nullable_string" },
        "dtype": { "$ref": "#/$defs/nullable_string" },
        "tokenization_mode": { "$ref": "#/$defs/nullable_string" },
        "sequence_length": { "$ref": "#/$defs/nullable_integer" },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "total_shards": { "type": "integer", "minimum": 1 },
        "estimated_sequences": { "$ref": "#/$defs/nullable_integer" }
      }
    },
    "dataset_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_version", "dataset_label", "eval_n", "delta_threshold", "created_at", "sources"],
      "properties": {
        "config_version": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "dataset_label": { "type": "string", "minLength": 1 },
        "eval_n": { "type": "integer", "minimum": 1 },
        "delta_threshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dataset_source" }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hotkey", "coldkey", "uid"],
      "properties": {
        "hotkey": { "type": "string", "minLength": 1 },
        "coldkey": { "$ref": "#/$defs/nullable_string" },
        "uid": { "type": "integer", "minimum": 0 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_repo", "model_digest", "model_reference"],
      "properties": {
        "model_repo": { "$ref": "#/$defs/nullable_string" },
        "model_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "model_reference": { "type": "string", "pattern": "^models/sha256/[0-9a-f]{64}/$" }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "netuid", "generation", "competition", "seed_repo", "seed_digest", "seed_repo_backend", "finalized_start_block", "last_finalized_block", "observed_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "netuid": { "type": "integer", "minimum": 0 },
        "generation": { "type": "string", "minLength": 1 },
        "competition": { "type": "string", "minLength": 1 },
        "seed_repo": { "$ref": "#/$defs/nullable_string" },
        "seed_digest": { "$ref": "#/$defs/nullable_string" },
        "seed_repo_backend": { "$ref": "#/$defs/nullable_string" },
        "finalized_start_block": { "$ref": "#/$defs/nullable_integer" },
        "last_finalized_block": { "$ref": "#/$defs/nullable_integer" },
        "observed_at": { "$ref": "#/$defs/nullable_timestamp" }
      }
    },
    "king": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hotkey", "coldkey", "uid", "model_repo", "model_digest", "model_reference", "king_digest", "reign_number", "crowned_at", "crowned_finalized_block", "mu_hat", "lcb", "delta", "avg_king_loss", "avg_challenger_loss", "wall_time_s"],
      "properties": {
        "hotkey": { "type": "string", "minLength": 1 },
        "coldkey": { "$ref": "#/$defs/nullable_string" },
        "uid": { "type": "integer", "minimum": 0 },
        "model_repo": { "$ref": "#/$defs/nullable_string" },
        "model_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "model_reference": { "type": "string", "pattern": "^models/sha256/[0-9a-f]{64}/$" },
        "king_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reign_number": { "type": "integer", "minimum": 0 },
        "crowned_at": { "$ref": "#/$defs/timestamp" },
        "crowned_finalized_block": { "type": "integer", "minimum": 0 },
        "mu_hat": { "$ref": "#/$defs/nullable_number" },
        "lcb": { "$ref": "#/$defs/nullable_number" },
        "delta": { "$ref": "#/$defs/nullable_number" },
        "avg_king_loss": { "$ref": "#/$defs/nullable_number" },
        "avg_challenger_loss": { "$ref": "#/$defs/nullable_number" },
        "wall_time_s": { "$ref": "#/$defs/nullable_number" }
      }
    },
    "payout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "alpha_per_hour", "usd_per_hour"],
      "properties": {
        "weight": { "$ref": "#/$defs/nullable_number" },
        "alpha_per_hour": { "$ref": "#/$defs/nullable_number" },
        "usd_per_hour": { "$ref": "#/$defs/nullable_number" }
      }
    },
    "reign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reign_number", "hotkey", "coldkey", "uid", "model_repo", "model_digest", "model_reference", "crowned_at", "crowned_finalized_block", "ended_at", "replacement_reason", "weight", "alpha_per_hour", "usd_per_hour"],
      "properties": {
        "reign_number": { "type": "integer", "minimum": 0 },
        "hotkey": { "type": "string", "minLength": 1 },
        "coldkey": { "$ref": "#/$defs/nullable_string" },
        "uid": { "type": "integer", "minimum": 0 },
        "model_repo": { "$ref": "#/$defs/nullable_string" },
        "model_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "model_reference": { "type": "string", "pattern": "^models/sha256/[0-9a-f]{64}/$" },
        "crowned_at": { "$ref": "#/$defs/timestamp" },
        "crowned_finalized_block": { "type": "integer", "minimum": 0 },
        "ended_at": { "$ref": "#/$defs/nullable_timestamp" },
        "replacement_reason": { "$ref": "#/$defs/nullable_string" },
        "weight": { "$ref": "#/$defs/nullable_number" },
        "alpha_per_hour": { "$ref": "#/$defs/nullable_number" },
        "usd_per_hour": { "$ref": "#/$defs/nullable_number" }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_registrations", "queue_depth", "completed_evaluations", "reign_count"],
      "properties": {
        "active_registrations": { "type": "integer", "minimum": 0 },
        "queue_depth": { "type": "integer", "minimum": 0 },
        "completed_evaluations": { "type": "integer", "minimum": 0 },
        "reign_count": { "type": "integer", "minimum": 0 }
      }
    },
    "current_eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge_id", "model_digest", "hotkey", "coldkey", "uid", "model_identity", "stage", "progress", "total", "percent", "elapsed_seconds", "early_stopped", "policy_version", "dataset_version", "started_at", "last_progress_at", "provisional_mu_hat", "provisional_lcb", "provisional_n_sequences", "provisional_n_bootstrap", "delta_threshold"],
      "properties": {
        "challenge_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "model_digest": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "hotkey": { "type": "string", "minLength": 1 },
        "coldkey": { "$ref": "#/$defs/nullable_string" },
        "uid": { "type": "integer", "minimum": 0 },
        "model_identity": { "const": "hidden_until_promotion" },
        "stage": { "type": "string", "minLength": 1 },
        "progress": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "percent": { "$ref": "#/$defs/nullable_number" },
        "elapsed_seconds": { "$ref": "#/$defs/nullable_number" },
        "early_stopped": { "type": "boolean" },
        "policy_version": { "type": "string", "minLength": 1 },
        "dataset_version": { "type": "string", "minLength": 1 },
        "started_at": { "$ref": "#/$defs/nullable_timestamp" },
        "last_progress_at": { "$ref": "#/$defs/nullable_timestamp" },
        "provisional_mu_hat": { "$ref": "#/$defs/nullable_number" },
        "provisional_lcb": { "$ref": "#/$defs/nullable_number" },
        "provisional_n_sequences": { "$ref": "#/$defs/nullable_integer" },
        "provisional_n_bootstrap": { "$ref": "#/$defs/nullable_integer" },
        "delta_threshold": { "$ref": "#/$defs/nullable_number" }
      }
    },
    "queue_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge_id", "model_digest", "hotkey", "coldkey", "uid", "model_identity", "block", "queue_position", "state", "submitted_at"],
      "properties": {
        "challenge_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "model_digest": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "hotkey": { "type": "string", "minLength": 1 },
        "coldkey": { "$ref": "#/$defs/nullable_string" },
        "uid": { "type": "integer", "minimum": 0 },
        "model_identity": { "const": "hidden_until_promotion" },
        "block": { "type": "integer", "minimum": 0 },
        "queue_position": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["queued", "retrying", "processing"] },
        "submitted_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge_id", "hotkey", "coldkey", "uid", "baseline_hotkey", "baseline_coldkey", "baseline_uid", "verdict", "accepted", "mu_hat", "lcb", "delta", "avg_king_loss", "avg_challenger_loss", "wall_time_s", "n_sequences_evaluated", "n_sequences", "early_stopped", "shards_used", "source_scores", "error_code", "error_message", "policy_version", "dataset_version", "timestamp", "challenger_repo", "challenger_digest", "model_reference", "publication_disposition", "model_identity"],
      "properties": {
        "challenge_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "hotkey": { "type": "string", "minLength": 1 },
        "coldkey": { "$ref": "#/$defs/nullable_string" },
        "uid": { "type": "integer", "minimum": 0 },
        "baseline_hotkey": { "type": "string", "minLength": 1 },
        "baseline_coldkey": { "$ref": "#/$defs/nullable_string" },
        "baseline_uid": { "type": "integer", "minimum": 0 },
        "verdict": { "enum": ["accepted", "rejected", "error"] },
        "accepted": { "type": "boolean" },
        "mu_hat": { "$ref": "#/$defs/nullable_number" },
        "lcb": { "$ref": "#/$defs/nullable_number" },
        "delta": { "$ref": "#/$defs/nullable_number" },
        "avg_king_loss": { "$ref": "#/$defs/nullable_number" },
        "avg_challenger_loss": { "$ref": "#/$defs/nullable_number" },
        "wall_time_s": { "$ref": "#/$defs/nullable_number" },
        "n_sequences_evaluated": { "$ref": "#/$defs/nullable_integer" },
        "n_sequences": { "$ref": "#/$defs/nullable_integer" },
        "early_stopped": { "type": "boolean" },
        "shards_used": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "names"],
            "properties": {
              "source": { "type": "string", "minLength": 1, "maxLength": 128 },
              "names": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1, "maxLength": 512 }
              }
            }
          }
        },
        "source_scores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "n_sequences", "avg_king_loss", "avg_challenger_loss", "mu_hat"],
            "properties": {
              "source": { "type": "string", "minLength": 1, "maxLength": 128 },
              "n_sequences": { "type": "integer", "minimum": 0 },
              "avg_king_loss": { "type": "number" },
              "avg_challenger_loss": { "type": "number" },
              "mu_hat": { "type": "number" }
            }
          }
        },
        "category_scores": { "$ref": "#/$defs/history_entry/properties/source_scores" },
        "category_scores_pending": { "type": "boolean" },
        "error_code": { "$ref": "#/$defs/nullable_string" },
        "error_message": { "$ref": "#/$defs/nullable_string" },
        "policy_version": { "$ref": "#/$defs/nullable_string" },
        "dataset_version": { "$ref": "#/$defs/nullable_string" },
        "timestamp": { "$ref": "#/$defs/nullable_timestamp" },
        "challenger_repo": { "$ref": "#/$defs/nullable_string" },
        "challenger_digest": { "$ref": "#/$defs/nullable_string" },
        "model_reference": { "$ref": "#/$defs/nullable_string" },
        "publication_disposition": { "type": ["string", "null"], "enum": ["winner", "non_winner", null] },
        "model_identity": { "enum": ["public", "hidden_until_promotion"] },
        "registration_state": { "enum": ["pending_activation", "active", "inactive"] },
        "upload_id": { "type": "string", "format": "uuid" },
        "upload_state": { "const": "verification_failed" }
      }
    },
    "weight_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "cadence_blocks", "last_attempted_block", "next_due_block", "latest_attempt_state", "latest_finalized_block", "error_code", "requested_at", "submitted_at", "finalized_at"],
      "properties": {
        "state": { "$ref": "#/$defs/nullable_string" },
        "cadence_blocks": { "$ref": "#/$defs/nullable_integer" },
        "last_attempted_block": { "$ref": "#/$defs/nullable_integer" },
        "next_due_block": { "$ref": "#/$defs/nullable_integer" },
        "latest_attempt_state": { "$ref": "#/$defs/nullable_string" },
        "latest_finalized_block": { "$ref": "#/$defs/nullable_integer" },
        "error_code": { "$ref": "#/$defs/nullable_string" },
        "requested_at": { "$ref": "#/$defs/nullable_timestamp" },
        "submitted_at": { "$ref": "#/$defs/nullable_timestamp" },
        "finalized_at": { "$ref": "#/$defs/nullable_timestamp" }
      }
    },
    "service_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "health", "heartbeat_age_seconds", "phase"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "health": { "enum": ["healthy", "degraded", "stale", "offline"] },
        "heartbeat_age_seconds": { "type": "integer", "minimum": 0 },
        "phase": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "service_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "validator_phase", "validator_heartbeat_age_seconds", "current_evaluation_age_seconds", "weight_delayed", "services"],
      "properties": {
        "overall": { "enum": ["healthy", "degraded", "stale", "offline"] },
        "validator_phase": { "$ref": "#/$defs/nullable_string" },
        "validator_heartbeat_age_seconds": { "$ref": "#/$defs/nullable_integer" },
        "current_evaluation_age_seconds": { "$ref": "#/$defs/nullable_integer" },
        "weight_delayed": { "type": "boolean" },
        "services": { "type": "array", "items": { "$ref": "#/$defs/service_health" } }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fetched_at", "stale", "tao_price_usd", "tao_change_24h", "sn3_alpha_price_tao", "sn3_reg_burn_tao"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 64 },
        "fetched_at": { "$ref": "#/$defs/timestamp" },
        "stale": { "type": "boolean" },
        "tao_price_usd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "tao_change_24h": { "type": "number", "minimum": -100, "maximum": 100000 },
        "sn3_alpha_price_tao": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "sn3_reg_burn_tao": { "type": "number", "minimum": 0, "maximum": 1000000000 }
      }
    }
  }
}
