# Copy to .env on the validator/control-plane host. Never commit .env.

# Runtime
TEUTONIC_PYTHON=.venv/bin/python
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
HF_API_TOKEN=replace-with-private-hugging-face-read-token

# Control-plane identity
TEUTONIC_NETWORK=finney
TEUTONIC_NETUID=3
TEUTONIC_CHAIN_GENERATION=teutonic-II-110B-hf-dbacb5e544b03345ca7b8cc322e74ac08bb0cc36
TEUTONIC_COMPETITION=Teutonic-II-110B

# Weight publisher wallet (required only in active mode)
BT_WALLET_PATH=/home/validator/.bittensor/wallets
BT_WALLET_NAME=teutonic
BT_WALLET_HOTKEY=default

# PostgreSQL container and shared control-plane login.
POSTGRES_DB=teutonic
POSTGRES_USER=teutonic
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=55432
TEUTONIC_DATABASE_URL=postgresql://teutonic:replace-me@127.0.0.1:55432/teutonic

# Validator scheduler and remote GPU evaluator
TEUTONIC_EVAL_SERVER=http://127.0.0.1:9000
TEUTONIC_EVAL_SSH_HOST=replace-with-gpu-ssh-host
TEUTONIC_EVAL_SSH_PORT=22
TEUTONIC_EVAL_SSH_USER=root
TEUTONIC_EVAL_SSH_IDENTITY_FILE=/home/validator/.ssh/id_ed25519
TEUTONIC_EVAL_SSH_KNOWN_HOSTS_FILE=/home/validator/.ssh/known_hosts
TEUTONIC_EVAL_SSH_STRICT_HOST_KEY_CHECKING=accept-new
TEUTONIC_EVAL_SSH_CONNECT_TIMEOUT_SECONDS=15
TEUTONIC_EVAL_SSH_SERVER_ALIVE_INTERVAL_SECONDS=30
TEUTONIC_EVAL_SSH_SERVER_ALIVE_COUNT_MAX=3
TEUTONIC_EVAL_TUNNEL_LOCAL_HOST=127.0.0.1
TEUTONIC_EVAL_TUNNEL_LOCAL_PORT=9000
TEUTONIC_EVAL_TUNNEL_REMOTE_HOST=127.0.0.1
TEUTONIC_EVAL_TUNNEL_REMOTE_PORT=9000
TEUTONIC_VALIDATOR_POLL_SECONDS=12
TEUTONIC_HEARTBEAT_SECONDS=30
TEUTONIC_WEIGHT_PLAN_REFRESH_SECONDS=12
TEUTONIC_EVALUATION_POLICY_VERSION=document-masked-token-bootstrap-v1
TEUTONIC_EVALUATOR_CODE_VERSION=replace-with-same-version-as-gpu
TEUTONIC_EVALUATOR_VERSION=pair-evaluator-v2
TEUTONIC_EVAL_BOOTSTRAP_SEED=0
TEUTONIC_EVAL_SEQ_LEN=2048
TEUTONIC_EVAL_BOOTSTRAP_B=10000
TEUTONIC_EVAL_ALPHA=0.001
TEUTONIC_EVAL_BATCH_SIZE=40
TEUTONIC_EVALUATION_LEASE_SECONDS=120
TEUTONIC_EVALUATION_RETRY_SECONDS=30
TEUTONIC_EVALUATION_MAX_ATTEMPTS=3
TEUTONIC_PUBLISH_NON_WINNING_MODELS=false

# Validator-owned private/public model storage and recoverable promotion
TEUTONIC_PRIVATE_MODEL_BUCKET=teutonic-private-models-enam
TEUTONIC_PUBLIC_MODEL_BUCKET=teutonic-models-enam
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_SESSION_TOKEN=
TEUTONIC_R2_ENDPOINT=
TEUTONIC_R2_REGION=auto

# Access controller: stable values are required to resume encrypted durable state.
TEUTONIC_CONTROLLER_SECRET_KEY=replace-with-64-hex-characters
TEUTONIC_MAILBOX_SIGNING_KEY=replace-with-64-hex-characters
TEUTONIC_MAILBOX_PUBLIC_BASE_URL=https://pub-fedac496355c4edc9aed57189e6e190f.r2.dev
TEUTONIC_ACCESS_CONTROLLER_POLL_SECONDS=2
TEUTONIC_ACCESS_CONTROLLER_LEASE_SECONDS=120
TEUTONIC_ACCESS_CONTROLLER_RETRY_SECONDS=5
TEUTONIC_RCLONE_REMOTE=teutonicr2
TEUTONIC_PROMOTION_LEASE_SECONDS=120
TEUTONIC_PROMOTION_RETRY_SECONDS=30
TEUTONIC_PROMOTION_MAX_ATTEMPTS=8

# Preserve the existing equal-share policy: current king plus four prior kings.
TEUTONIC_KING_CHAIN_SIZE=5
TEUTONIC_BURN_UID=0

# Weight publisher. Keep dry_run until the production wallet and database are verified.
TEUTONIC_WEIGHT_PUBLISHER_MODE=dry_run
TEUTONIC_WEIGHT_POLL_SECONDS=12
TEUTONIC_WEIGHT_MORTALITY_BLOCKS=128
TEUTONIC_WEIGHT_VERSION_KEY=10005000

# Dashboard object publication
TEUTONIC_CHAIN_NAME=Teutonic-II-110B
TEUTONIC_DASHBOARD_BUCKET=teutonic-dash-enam
TEUTONIC_DASHBOARD_R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
TEUTONIC_DASHBOARD_R2_ACCESS_KEY_ID=replace-me
TEUTONIC_DASHBOARD_R2_SECRET_ACCESS_KEY=replace-me
TEUTONIC_DASHBOARD_R2_SESSION_TOKEN=
TEUTONIC_DASHBOARD_MAX_BYTES=10485760
TEUTONIC_MARKET_URL=
TEUTONIC_MARKET_SOURCE=
TEUTONIC_MARKET_REFRESH_SECONDS=60
TEUTONIC_MARKET_MAX_STALE_SECONDS=3600
