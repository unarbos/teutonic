# Copy to .gpu.env on the remote GPU host. Never commit .gpu.env.

# Runtime and listener. Keep 127.0.0.1 when using a tunnel or local proxy.
TEUTONIC_PYTHON=.venv/bin/python
PYTHONUNBUFFERED=1
LOG_LEVEL=info
EVAL_HOST=127.0.0.1
EVAL_PORT=9000
EVAL_GPUS=auto
TOKENIZERS_PARALLELISM=false

# Read-only model artifacts supplied by the validator scheduler. The evaluator
# accepts only the hardcoded teutonic-models-enam and
# teutonic-private-models-enam buckets.
TEUTONIC_EVALUATOR_R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
TEUTONIC_EVALUATOR_R2_ACCESS_KEY_ID=replace-me
TEUTONIC_EVALUATOR_R2_SECRET_ACCESS_KEY=replace-me
TEUTONIC_EVALUATOR_R2_SESSION_TOKEN=
TEUTONIC_EVALUATOR_R2_REGION=auto

# Pretokenized evaluation shard URLs and exact sample targets arrive in each
# signed validator request. The GPU host has no dataset registry or tokenizer.

# Protocol-v2 identity and server-side safety caps. The validator scheduler
# supplies the durable evaluation policy values in each request.
EVAL_N_CAP=30000
EVAL_BOOTSTRAP_B_CAP=999999
EVAL_MAX_RUNTIME_S=0
EVAL_LOG_EVERY_BATCHES=1
TEUTONIC_EVALUATOR_VERSION=pair-evaluator-v2
TEUTONIC_EVALUATION_POLICY_VERSION=paired-bootstrap-v1
TEUTONIC_EVALUATOR_CODE_VERSION=replace-with-deployment-version

# GPU and model loading
TEUTONIC_MODEL_DEVICE_MAP=auto
TEUTONIC_GPU_MEMORY_FRACTION=0.45
TEUTONIC_LM_HEAD_CHUNK=1024
TEUTONIC_ATTN_IMPLEMENTATION=flash_attention_4
TEUTONIC_EVAL_BATCH_SIZE=40

# S3 transfer resilience
TEUTONIC_S3_DOWNLOAD_RETRIES=5
TEUTONIC_S3_DOWNLOAD_RETRY_BACKOFF_S=20
TEUTONIC_S3_CLIENT_MAX_ATTEMPTS=10
TEUTONIC_S3_TRANSFER_ATTEMPTS=10
TEUTONIC_S3_TRANSFER_CONCURRENCY=1
TEUTONIC_S3_TRANSFER_CHUNK_MB=64

# Local caches and audit records
TEUTONIC_MODEL_CACHE_DIR=/tmp/teutonic/pair_models
TEUTONIC_EVAL_RECORD_DIR=/tmp/teutonic/pair_evals
TEUTONIC_SHARD_CACHE_DIR=/tmp/teutonic/finewebedu_shards
TEUTONIC_MULTI_SOURCE_CACHE_DIR=/tmp/teutonic/finewebedu_shards/_multi_source_urls
TEUTONIC_KERNEL_CACHE_DIR=/tmp/teutonic/kernel_cache
TEUTONIC_COMPLETED_SAFETENSORS_SHA_FILE=/tmp/teutonic/completed_safetensors_sha256.txt
MODEL_CACHE_HIGH_WATERMARK_GB=500
MODEL_CACHE_MIN_AGE_H=3
MODEL_CACHE_MAX_AGE_DAYS=0.0833333333
MODEL_CACHE_KEEP_RECENT=1
SHARD_CACHE_MIN_AGE_H=0.5
SHARD_CACHE_MAX_AGE_H=3
TEUTONIC_MODEL_CACHE_CLEANUP_CRON=*/30 * * * *
TEUTONIC_SHARD_CACHE_CLEANUP_CRON=*/30 * * * *
